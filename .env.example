# --- Server ---
PORT=4000
NODE_ENV=production
# Comma separated list of browser origins allowed to call /api/billing/*
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app (Stripe redirects back here)
APP_URL=http://localhost:3000

# --- Supabase (service role key = SERVER ONLY, never expose to the browser) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring monthly prices created in the Stripe dashboard:
#   Growth Pro = $49 / month, Enterprise Scale = $249 / month
STRIPE_PRICE_GROWTH_PRO=price_...
STRIPE_PRICE_ENTERPRISE_SCALE=price_...
